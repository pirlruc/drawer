{
  "dependencies": [
    {
      "name": "improc-corecv",
      "version>=": "1f2705e6ad4e1d3bea6aae64c2fcc01037adc97a"
    }
  ],
  "features": {
    "qrcode": {
      "description": "Support QR-Code generation and decoding",
      "dependencies": [
        {
          "name": "nayuki-qr-code-generator",
          "version>=": "1.8.0"
        },
        {
          "name": "nu-book-zxing-cpp",
          "version>=": "2.2.1"
        }
      ]
    },
    "data-matrix": {
      "description": "Support barcode and data matrix generation and decoding",
      "dependencies": [
        {
          "name": "nu-book-zxing-cpp",
          "version>=": "2.2.1"
        }
      ]
    },
    "text": {
      "description": "Support text generation",
      "dependencies": [
        {
          "name": "freetype",
          "version>=": "2.13.2",
          "features": ["bzip2","zlib","png","error-strings","subpixel-rendering"]
        }
      ]
    },
    "tests": {
      "description": "Support test library",
      "dependencies": [
        {
          "name": "gtest",
          "version>=": "1.15.2"
        }
      ]
    }
  }
}