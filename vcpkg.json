{
  "name": "improc-drawer",
  "version": "1.0.0",
  "port-version": 0,
  "dependencies": [
    {
      "name": "spdlog",
      "version>=": "1.15.2"
    },
    {
      "name": "jsoncpp",
      "version>=": "1.9.6"
    },
    {
      "name": "opencv",
      "version>=": "4.11.0",
      "features": ["default-features","ipp","tbb","thread","opencl","openmp","opengl","jpeg","png","tiff"],
      "platform": "windows"
    },
    {
      "name": "opencv",
      "version>=": "4.11.0",
      "features": ["default-features","thread","opencl","openmp","opengl","jpeg","png","tiff"],
      "platform": "!windows"
    }
  ],
  "features": {
    "qrcode": {
      "description": "Support QR-Code generation and decoding",
      "dependencies": [
        {
          "name": "nayuki-qr-code-generator",
          "version>=": "1.8.0"
        },
        {
          "name": "nu-book-zxing-cpp",
          "version>=": "2.3.0"
        }
      ]
    },
    "data-matrix": {
      "description": "Support barcode and data matrix generation and decoding",
      "dependencies": [
        {
          "name": "nu-book-zxing-cpp",
          "version>=": "2.3.0"
        }
      ]
    },
    "text": {
      "description": "Support text generation",
      "dependencies": [
        {
          "name": "freetype",
          "version>=": "2.13.3",
          "features": ["bzip2","subpixel-rendering","zlib","png","error-strings"]
        }
      ]
    },
    "tests": {
      "description": "Support test library",
      "dependencies": [
        {
          "name": "gtest",
          "version>=": "1.16.0"
        }
      ]
    }
  },
  "builtin-baseline": "53bef8994c541b6561884a8395ea35715ece75db"
}